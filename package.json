{
  "name": "rune",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-native workspace for documents, data, and presentations.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "dev": "npm run prepare:ocr && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run prepare:ocr && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "npm run prepare:ocr && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run locales:check && npm run eval:golden && npm run test:unit && npm run test:render",
    "test:unit": "npm run prepare:ocr && node --experimental-strip-types --test tests/*.test.mjs",
    "test:render": "npm run build && node --experimental-strip-types --test tests-render/*.test.mjs",
    "test:e2e": "playwright test",
    "eval:golden": "node --experimental-strip-types scripts/run-golden-task-eval.mjs",
    "pilot:aggregate": "node --experimental-strip-types scripts/aggregate-pilot-evidence.mjs",
    "pilot:commercial": "node --experimental-strip-types scripts/evaluate-pilot-commercial.mjs",
    "pilot:interviews": "node --experimental-strip-types scripts/evaluate-pilot-interviews.mjs",
    "pilot:outcomes": "node --experimental-strip-types scripts/evaluate-pilot-outcomes.mjs",
    "qa:pdf": "node --experimental-strip-types scripts/generate-pdf-qa.mjs",
    "qa:pdf-import": "node --experimental-strip-types scripts/generate-pdf-import-qa.mjs",
    "qa:odf": "node --experimental-strip-types scripts/generate-odf-qa.mjs",
    "qa:legacy-office": "node --experimental-strip-types scripts/generate-legacy-office-qa.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "locales:generate": "node scripts/generate-traditional-chinese.mjs",
    "locales:check": "node scripts/generate-traditional-chinese.mjs --check && node --experimental-strip-types scripts/generate-interface-locales.mjs --check",
    "locales:interface:generate": "node --experimental-strip-types scripts/generate-interface-locales.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "npm run build && electron desktop/main.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@xmldom/xmldom": "0.9.10",
    "fflate": "0.8.3",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "openai": "7.4.0",
    "papaparse": "5.5.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tesseract.js": "7.0.0",
    "unified": "11.0.5",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.52.0",
    "@cloudflare/workers-types": "5.20260813.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "43.2.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "opencc-js": "1.4.1",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.122.0"
  },
  "type": "module",
  "overrides": {
    "image-size": "1.2.1"
  }
}
