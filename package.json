{
  "name": "orbit-office",
  "version": "1.65.0",
  "private": true,
  "productName": "Orbit",
  "main": "desktop/main.mjs",
  "repository": "https://github.com/JackieHuJunyi/Orbit.git",
  "description": "Orbit — a source-native workspace for people and AI to create documents, data, and presentations together.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "prepare:duckdb": "node scripts/prepare-duckdb.mjs",
    "prepare:qpdf": "node scripts/prepare-qpdf.mjs",
    "prepare:ghostscript": "node scripts/prepare-ghostscript.mjs",
    "prepare:runtime": "npm run prepare:ocr && npm run prepare:duckdb && npm run prepare:qpdf && npm run prepare:ghostscript",
    "dev": "npm run prepare:runtime && node scripts/run-vinext.mjs dev",
    "build": "npm run prepare:runtime && node scripts/run-vinext.mjs build",
    "start": "npm run prepare:runtime && node scripts/run-vinext.mjs start",
    "start:e2e": "npm run prepare:runtime && node scripts/start-e2e.mjs",
    "test": "npm run locales:check && npm run eval:golden && npm run test:unit && npm run test:render",
    "test:unit": "npm run prepare:runtime && node --experimental-strip-types --test tests/*.test.mjs",
    "test:render": "npm run build && node --experimental-strip-types --test tests-render/*.test.mjs",
    "test:e2e": "playwright test",
    "eval:golden": "node --experimental-strip-types scripts/run-golden-task-eval.mjs",
    "pilot:aggregate": "node --experimental-strip-types scripts/aggregate-pilot-evidence.mjs",
    "pilot:commercial": "node --experimental-strip-types scripts/evaluate-pilot-commercial.mjs",
    "pilot:interviews": "node --experimental-strip-types scripts/evaluate-pilot-interviews.mjs",
    "pilot:outcomes": "node --experimental-strip-types scripts/evaluate-pilot-outcomes.mjs",
    "qa:pdf": "node --experimental-strip-types scripts/generate-pdf-qa.mjs",
    "qa:pdf-import": "node --experimental-strip-types scripts/generate-pdf-import-qa.mjs",
    "qa:odf": "node --experimental-strip-types scripts/generate-odf-qa.mjs",
    "qa:legacy-office": "node --experimental-strip-types scripts/generate-legacy-office-qa.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "audit:tooling": "npm audit --audit-level=high",
    "locales:generate": "node scripts/generate-traditional-chinese.mjs",
    "locales:check": "node scripts/generate-traditional-chinese.mjs --check && node --experimental-strip-types scripts/generate-interface-locales.mjs --check && node --experimental-strip-types scripts/compile-interface-locales.mjs --check",
    "locales:interface:generate": "node --experimental-strip-types scripts/generate-interface-locales.mjs && npm run locales:runtime:generate",
    "locales:runtime:generate": "node --experimental-strip-types scripts/compile-interface-locales.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "npm run build && electron desktop/main.mjs",
    "prepare:macos-icon": "node scripts/prepare-macos-icon.mjs",
    "desktop:package:mac": "npm run build && npm run prepare:macos-icon && node scripts/package-macos.mjs",
    "desktop:verify:mac": "node scripts/verify-macos-release.mjs",
    "desktop:smoke:mac": "node scripts/smoke-macos-package.mjs",
    "desktop:release:mac": "npm run build && npm run prepare:macos-icon && node scripts/package-macos.mjs --arch=arm64 --require-signing && node scripts/package-macos.mjs --arch=x64 --require-signing"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@jspawn/ghostscript-wasm": "0.0.2",
    "@jspawn/qpdf-wasm": "0.0.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@xmldom/xmldom": "0.9.12",
    "apache-arrow": "17.0.0",
    "fflate": "0.8.3",
    "harfbuzzjs": "1.4.0",
    "lucide-react": "1.31.0",
    "next": "16.3.5",
    "openai": "7.4.0",
    "papaparse": "5.5.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tegaki": "0.22.1",
    "tesseract.js": "7.0.0",
    "unified": "11.0.5",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@electron/asar": "4.3.0",
    "@electron/fuses": "2.1.3",
    "@electron/get": "5.1.0",
    "@electron/notarize": "3.1.1",
    "@electron/osx-sign": "2.7.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "electron": "43.2.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "opencc-js": "1.4.1",
    "plist": "3.1.1",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.1",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "overrides": {
    "browserslist": "4.28.8",
    "fast-uri": "3.1.6"
  }
}
