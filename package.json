{
  "name": "rune",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-native workspace for documents, data, and presentations.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "qa:pdf": "node --experimental-strip-types scripts/generate-pdf-qa.mjs",
    "qa:pdf-import": "node --experimental-strip-types scripts/generate-pdf-import-qa.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@xmldom/xmldom": "0.9.10",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "papaparse": "^5.5.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
