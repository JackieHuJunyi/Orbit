# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/
/desktop/orbit-app-icon.icns

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/output/
/tmp/

# Local real-pilot evidence. Never commit participant packages or cohort reports.
/pilot-private/
rune-pilot-evidence-*.json
rune-pilot-cohort-*.json
rune-pilot-cohort-*.md

# OCR runtime assets are regenerated from node_modules + vendor/tessdata by
# `npm run prepare:ocr`; never commit the generated copies.
/public/ocr/

# DuckDB browser worker/Wasm assets are regenerated from node_modules by
# `npm run prepare:duckdb`; never commit the generated ~39 MB pair.
/public/duckdb/

# qpdf's browser binary is regenerated from the pinned npm package. The small
# Orbit-owned worker stays tracked beside these generated runtime files.
/public/qpdf/qpdf.js
/public/qpdf/qpdf.wasm

# Ghostscript is also regenerated from its pinned npm package; keep only the
# Orbit-owned worker in source control.
/public/ghostscript/gs.js
/public/ghostscript/gs.wasm

# Local OpenAI Sites hosting metadata (project id, optional d1/r2 bindings).
# Copy from .openai/hosting.example.json — never commit a real project id.
.openai/hosting.json

# Playwright artifacts
/test-results/
/playwright-report/

# Project-local dependency download cache
/.npm-cache/
